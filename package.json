{
  "name": "xp-code-canvas",
  "displayName": "XP Python UML Canvas",
  "description": "Python architecture and code review across synchronized 2D UML, 3D graph and Sankey lenses",
  "publisher": "xp-libs",
  "version": "0.8.1",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rrodrigoa/xp-code-canvas.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "python",
    "uml",
    "graph",
    "code navigation",
    "architecture"
  ],
  "main": "./dist/extension/extension.js",
  "activationEvents": [
    "onCommand:xpCodeCanvas.open",
    "onCommand:xpCodeCanvas.focusCurrentFile",
    "onCommand:xpCodeCanvas.focusFile",
    "onCommand:xpCodeCanvas.returnToCanvas",
    "onWebviewPanel:xpCodeCanvas.canvas",
    "onView:xpCodeCanvas.structure",
    "onView:xpCodeCanvas.history",
    "onView:xpCodeCanvas.reviews",
    "onCommand:xpCodeCanvas.open3D",
    "onView:xpCodeCanvas.explore"
  ],
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "xpCodeCanvas.open",
        "title": "Open UML Canvas",
        "category": "Python UML Canvas",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "xpCodeCanvas.open3D",
        "title": "Open 3D UML Canvas",
        "category": "Python UML Canvas",
        "icon": "$(globe)"
      },
      {
        "command": "xpCodeCanvas.focusCurrentFile",
        "title": "Focus Current File in UML Canvas",
        "category": "Python UML Canvas",
        "icon": "$(target)"
      },
      {
        "command": "xpCodeCanvas.focusFile",
        "title": "Focus File in UML Canvas",
        "category": "Python UML Canvas",
        "icon": "$(graph)"
      },
      {
        "command": "xpCodeCanvas.openNodeInEditor",
        "title": "Open Selected UML Node in Editor",
        "category": "Python UML Canvas",
        "icon": "$(screen-full)"
      },
      {
        "command": "xpCodeCanvas.returnToCanvas",
        "title": "Return to UML Canvas",
        "category": "Python UML Canvas",
        "icon": "$(graph)"
      },
      {
        "command": "xpCodeCanvas.alignFocusedFile",
        "title": "Align Focused File",
        "category": "Python UML Canvas"
      },
      {
        "command": "xpCodeCanvas.resetLayout",
        "title": "Reset UML Layout",
        "category": "Python UML Canvas"
      },
      {
        "command": "xpCodeCanvas.fitView",
        "title": "Fit UML Graph to View",
        "category": "Python UML Canvas"
      },
      {
        "command": "xpCodeCanvas.toggleExplodedMethods",
        "title": "Expand or Collapse UML Method Nodes",
        "category": "Python UML Canvas"
      },
      {
        "command": "xpCodeCanvas.spreadGraph",
        "title": "Spread and Recover UML Layout",
        "category": "Python UML Canvas",
        "icon": "$(layout)"
      },
      {
        "command": "xpCodeCanvas.focusSymbol",
        "title": "Focus Symbol in UML Canvas",
        "category": "Python UML Canvas",
        "icon": "$(symbol-method)"
      },
      {
        "command": "xpCodeCanvas.showHistory",
        "title": "Show Git History in UML Canvas",
        "category": "Python UML Canvas",
        "icon": "$(git-commit)"
      },
      {
        "command": "xpCodeCanvas.showChanges",
        "title": "Show Current Git Changes in UML Canvas",
        "category": "Python UML Canvas",
        "icon": "$(git-compare)"
      },
      {
        "command": "xpCodeCanvas.compareCommit",
        "title": "Compare Commit in UML Canvas",
        "category": "Python UML Canvas",
        "icon": "$(git-compare)"
      },
      {
        "command": "xpCodeCanvas.refreshSidebar",
        "title": "Refresh Python Structure and Git History",
        "category": "Python UML Canvas",
        "icon": "$(refresh)"
      },
      {
        "command": "xpCodeCanvas.showBlame",
        "title": "Show Git Blame for Selected Symbol",
        "category": "Python UML Canvas",
        "icon": "$(git-commit)"
      },
      {
        "command": "xpCodeCanvas.reviewWorking",
        "title": "Review Working Changes in UML",
        "category": "Python UML Canvas",
        "icon": "$(git-compare)"
      },
      {
        "command": "xpCodeCanvas.reviewUnstaged",
        "title": "Review Unstaged Changes in UML",
        "category": "Python UML Canvas",
        "icon": "$(edit)"
      },
      {
        "command": "xpCodeCanvas.reviewStaged",
        "title": "Review Staged Changes in UML",
        "category": "Python UML Canvas",
        "icon": "$(git-commit)"
      },
      {
        "command": "xpCodeCanvas.reviewBranch",
        "title": "Review Branch Architecture",
        "category": "Python UML Canvas",
        "icon": "$(git-branch)"
      },
      {
        "command": "xpCodeCanvas.reviewPR",
        "title": "Review GitHub Pull Request in UML",
        "category": "Python UML Canvas",
        "icon": "$(git-pull-request)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "xpCodeCanvas.focusFile",
          "when": "resourceExtname == .py",
          "group": "navigation@15"
        }
      ],
      "editor/title": [
        {
          "command": "xpCodeCanvas.returnToCanvas",
          "when": "editorLangId == python && xpCodeCanvas.hasCanvas",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "xpCodeCanvas.open",
          "when": "view == xpCodeCanvas.structure",
          "group": "navigation@1"
        },
        {
          "command": "xpCodeCanvas.spreadGraph",
          "when": "view == xpCodeCanvas.structure",
          "group": "navigation@2"
        },
        {
          "command": "xpCodeCanvas.refreshSidebar",
          "when": "view == xpCodeCanvas.structure || view == xpCodeCanvas.history",
          "group": "navigation@3"
        },
        {
          "command": "xpCodeCanvas.showHistory",
          "when": "view == xpCodeCanvas.history",
          "group": "navigation@4"
        },
        {
          "command": "xpCodeCanvas.showChanges",
          "when": "view == xpCodeCanvas.history",
          "group": "navigation@5"
        },
        {
          "command": "xpCodeCanvas.showBlame",
          "when": "view == xpCodeCanvas.structure",
          "group": "navigation@6"
        },
        {
          "command": "xpCodeCanvas.open3D",
          "when": "view == xpCodeCanvas.structure",
          "group": "navigation@15"
        }
      ],
      "view/item/context": [
        {
          "command": "xpCodeCanvas.focusSymbol",
          "when": "view == xpCodeCanvas.structure && (viewItem == xpCanvasSymbol || viewItem == xpCanvasModule)",
          "group": "inline"
        },
        {
          "command": "xpCodeCanvas.compareCommit",
          "when": "view == xpCodeCanvas.history && viewItem == xpCanvasCommit",
          "group": "inline"
        }
      ],
      "scm/title": [
        {
          "command": "xpCodeCanvas.reviewStaged",
          "group": "navigation@20"
        },
        {
          "command": "xpCodeCanvas.reviewWorking",
          "group": "navigation@21"
        }
      ]
    },
    "keybindings": [
      {
        "command": "xpCodeCanvas.returnToCanvas",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorLangId == python && xpCodeCanvas.hasCanvas"
      }
    ],
    "configuration": {
      "title": "XP Code Canvas",
      "properties": {
        "xpCodeCanvas.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable for extension-shipped offline AST analyzer; empty uses python/python3."
        },
        "xpCodeCanvas.defaultSemanticZoom": {
          "type": "string",
          "enum": [
            "overview",
            "structure",
            "source"
          ],
          "default": "structure"
        },
        "xpCodeCanvas.showImportEdges": {
          "type": "boolean",
          "default": true
        },
        "xpCodeCanvas.showCallEdges": {
          "type": "boolean",
          "default": true
        },
        "xpCodeCanvas.showReferenceEdges": {
          "type": "boolean",
          "default": false
        },
        "xpCodeCanvas.focusNeighborhoodDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 20
        },
        "xpCodeCanvas.explodeMethods": {
          "type": "boolean",
          "default": false
        },
        "xpCodeCanvas.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.venv/**",
            "**/venv/**",
            "**/__pycache__/**",
            "**/node_modules/**"
          ]
        },
        "xpCodeCanvas.editorNavigationPreview": {
          "type": "boolean",
          "default": false
        },
        "xpCodeCanvas.layoutDirection": {
          "type": "string",
          "enum": [
            "RIGHT",
            "DOWN"
          ],
          "default": "RIGHT"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xpCodeCanvas-sidebar",
          "title": "XP Code Canvas",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "xpCodeCanvas-sidebar": [
        {
          "id": "xpCodeCanvas.explore",
          "name": "Explore 2D / 3D",
          "icon": "media/structure.svg",
          "visibility": "visible"
        },
        {
          "id": "xpCodeCanvas.structure",
          "name": "Python Structure",
          "icon": "media/structure.svg",
          "visibility": "visible"
        },
        {
          "id": "xpCodeCanvas.history",
          "name": "Git History",
          "icon": "media/git-history.svg",
          "visibility": "collapsed"
        },
        {
          "id": "xpCodeCanvas.reviews",
          "name": "Code Reviews",
          "icon": "media/git-history.svg",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "xpCodeCanvas.structure",
        "contents": "Explore Python source as connected UML.\n[Open UML Canvas](command:xpCodeCanvas.open)\n[Spread Graph](command:xpCodeCanvas.spreadGraph)\nOpen a Python folder to index its symbols."
      },
      {
        "view": "xpCodeCanvas.history",
        "contents": "Open a Git repository to explore source history.\n[Refresh Git History](command:xpCodeCanvas.refreshSidebar)"
      },
      {
        "view": "xpCodeCanvas.reviews",
        "contents": "Review staged or working changes in the UML graph.\n[Review Working Tree](command:xpCodeCanvas.reviewWorking)\n[Review Staged Changes](command:xpCodeCanvas.reviewStaged)\n[Review GitHub PR](command:xpCodeCanvas.reviewPR)"
      }
    ]
  },
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 5175 --strictPort --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension-tests": "node scripts/build-extension-tests.mjs",
    "build": "npm run build:web && npm run build:extension && npm run build:extension-tests",
    "watch": "node scripts/build-extension.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src tests",
    "test:unit": "vitest run tests/unit --coverage",
    "test:python": "python -m pytest -q python/tests --cov=python/src/xp_canvas_analysis --cov-branch --cov-report=term-missing",
    "test:altitudes": "vitest run tests/unit/aggregation.test.ts",
    "test:semantic-diff": "vitest run tests/unit/semanticDiff.test.ts",
    "test:traces": "vitest run tests/unit/trace.test.ts",
    "test:canvas-e2e": "playwright test",
    "test:extension": "npm run build && vscode-test",
    "test:desktop-e2e": "extest setup-and-run --config extester.config.json",
    "test:real-repo": "node scripts/test-real-repository.mjs",
    "package": "npm run build && vsce package --out dist/xp-code-canvas-0.8.1.vsix",
    "verify:core": "npm run verify:fast && npm run test:canvas-e2e && npm run test:extension && npm run package",
    "verify": "npm run verify:core && npm run test:desktop-e2e",
    "test:contracts": "vitest run tests/unit/graphDelta.test.ts tests/unit/gitTree.test.ts",
    "verify:fast": "npm run typecheck && npm run lint && npm run test:python && npm run test:visual-smoke && npm run test:unit && npm run test:visual-v6 && npm run test:review:smoke && npm run test:spatial-v8 && npm run test:spatial-v81 && npm run test:feature-smoke && npm run test:v72-smoke && npm run test:v72-study",
    "test:visual-smoke": "node scripts/visual-smoke.cjs",
    "test:visual-v6": "node scripts/v6-visual-smoke.cjs",
    "test:feature-smoke": "node scripts/feature-smoke.cjs",
    "test:review:smoke": "node scripts/review-standalone-smoke.cjs && node scripts/review-notes-contract-smoke.cjs && node scripts/review-api-contract-smoke.cjs",
    "test:v72-smoke": "node scripts/v72-review-smoke.cjs",
    "test:v72-study": "python -m unittest discover -s studies/v72 -p test_*.py",
    "test:spatial-v8": "node --experimental-strip-types scripts/v8-spatial-smoke.mjs",
    "test:spatial-v81": "node scripts/v81-visual-smoke.cjs",
    "test:package": "python scripts/verify-vsix.py"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.40",
    "@xyflow/react": "^12.6.4",
    "elkjs": "^0.10.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.20",
    "zustand": "^5.0.5",
    "react-force-graph-3d": "^1.29.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.52.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.17",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/vscode": "^1.96.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.4",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "mocha": "^11.2.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.0",
    "vscode-extension-tester": "^8.0.0",
    "@vscode/vsce": "^3.5.0",
    "@types/three": "^0.181.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension runs an isolated local Python analyzer; trust is required before launching worker processes."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "UML graph and source navigation work where workspace.fs supports reads. Local Git comparison requires a file-backed workspace."
    }
  }
}
