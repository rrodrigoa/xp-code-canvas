{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "allowSyntheticDefaultImports": true, "esModuleInterop": true,
    "strict": true, "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "types": ["vite/client", "node"], "forceConsistentCasingInFileNames": true
  },
  "include": ["src/webview/**/*.tsx", "src/webview/**/*.ts", "src/shared/**/*.ts", "vite.config.ts"]
}
